# Factory API (orchestration + observability). Required.
DROIDLAND_FACTORY_API_KEY=fk-...
DROIDLAND_FACTORY_API_BASE=https://api.factory.ai
DROIDLAND_FACTORY_APP_BASE=https://app.factory.ai

# Detection connectors (read-only). Optional but needed for live triggers.
DROIDLAND_GITHUB_TOKEN=
DROIDLAND_LINEAR_API_KEY=

# Compute target repo for the shared Droid Computer (git URL or owner/name).
DROIDLAND_TARGET_REPO=

# Polling cadence (seconds).
DROIDLAND_POLL_INTERVAL_SECONDS=30
DROIDLAND_OBSERVABILITY_INTERVAL_SECONDS=15

# Default model used when an expert does not pin one.
DROIDLAND_DEFAULT_MODEL=claude-sonnet-4-5-20250929
